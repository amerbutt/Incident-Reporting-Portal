# ==============================================================================
# D12 COMMUNITY INCIDENT INTELLIGENCE PORTAL (IIP)
# ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE SHEETS MASTER DATA SOURCE (REQUIRED FOR LIVE SYNC)
# ------------------------------------------------------------------------------
# The Google Spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Cloud Service Account Client Email (e.g., service-account@project.iam.gserviceaccount.com)
# Share your private Google Sheet with this email with 'Viewer' permission
GOOGLE_SERVICE_ACCOUNT_EMAIL=d12-incident-sync@your-gcp-project.iam.gserviceaccount.com

# Google Service Account Private Key (multi-line RSA key or with \n escaped)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional Alternative: Google Sheets API Key (for read-only API key access)
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS API (OPTIONAL / ENHANCED MAPPING)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API key (Used for client-side Google Maps rendering)
# If not provided, portal seamlessly uses built-in high-definition GIS vector engine
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. AI INTELLIGENCE MODULE (OPTIONAL)
# ------------------------------------------------------------------------------
# LLM API keys for generative natural language intelligence synthesis
# If not provided, portal uses built-in statistical heuristic intelligence engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. SERVER CACHE & PERFORMANCE
# ------------------------------------------------------------------------------
# In-memory server cache TTL in seconds (Default: 300 seconds / 5 minutes)
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 5. FUTURE DATABASE MIGRATION LAYER (ROADMAP)
# ------------------------------------------------------------------------------
# PostgreSQL / Supabase / Prisma connection string for SQL database migration
DATABASE_URL=postgresql://postgres:password@localhost:5432/d12_incidents?schema=public
